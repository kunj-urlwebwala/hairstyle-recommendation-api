# --- Server ---
# Secret used to sign session JWTs. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# SQLite database file. Created automatically on first run.
DATABASE_URL=file:./database/mirror.db

# Where uploaded portraits and generated previews are stored
STORAGE_DIR=./storage/uploads

# --- AI providers (at least one key is required) ---
# Google AI Studio key for Gemini analysis + image try-on
GEMINI_API_KEY=
# OpenAI key used as fallback provider
OPENAI_API_KEY=

# Optional model overrides
AI_ANALYSIS_PRIMARY_MODEL=gemini-2.5-flash
AI_ANALYSIS_FALLBACK_MODEL=gpt-4o-mini
AI_TRYON_PRIMARY_IMAGE_MODEL=gemini-2.5-flash-image
AI_TRYON_FALLBACK_IMAGE_MODEL=gpt-image-1
AI_TRYON_IMAGE_QUALITY=medium

# --- Frontend ---
# Only needed when the app runs on a device/emulator; leave empty for web.
EXPO_PUBLIC_API_BASE_URL=
